{
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "vendor-dir": "vendor"
  },
  "description": "Shared tools for the Dayton Metro Barbershop Chorus WordPress site.",
  "name": "zagrev/dmbc-tools",
  "require": {
    "monolog/monolog": "^3.10",
    "yahnis-elsts/plugin-update-checker": "^5.7"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpunit/phpunit": "^9.6",
    "wp-cli/wp-cli": "^2.12",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "scripts": {
    "j2p": "php bin/json-php-serializer.php",
    "lint": "php -l dmbc-tools.php && php -l src/plugin.php",
    "test": "phpunit"
  },
  "type": "wordpress-plugin"
}
